# Copy to .env and fill in. Never commit the real .env.

# Core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database. Leave DATABASE_URL unset to use a local SQLite file for dev.
# In production this must point at the managed Postgres (Neon, Supabase, etc.).
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Object storage (Cloudflare R2 / any S3-compatible). Off by default for dev.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=

# AI assistant (Groq free tier, OpenAI-compatible). Leave blank to disable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
